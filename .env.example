# Supabase (GoTrue) auth endpoint — local dev uses Kong API gateway
PUBLIC_SUPABASE_URL=http://localhost:8000

# Supabase anonymous key — used for unauthenticated client initialization
# The key below is the default local dev key from supabase/postgres
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend REST API base URL
PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend WebSocket URL for real-time game updates
PUBLIC_WS_URL=ws://localhost:8080
