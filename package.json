    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/svelte": "^5.2.7",
    "jsdom": "^27.0.1",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.4",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4"
  }
